# ============================================================
# COMP5434 Cloud - Environment Variables
# Copy to .env and fill in your credentials:
#   cp .env.example .env
#   source .env
# ============================================================

# ---- Cloud Provider (aliyun | aws | gcp) ----
CLOUD_PROVIDER=aliyun
CLOUD_REGION=cn-hangzhou

# ---- Object Storage (Alibaba Cloud OSS) ----
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=comp5434-bucket
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# ---- Container Registry (Alibaba Cloud ACR) ----
ACR_ENDPOINT=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=comp5434
ACR_USERNAME=your_acr_username
ACR_PASSWORD=your_acr_password

# ---- Spark Cluster ----
SPARK_MASTER=local[*]           # Change to spark://spark-master:7077 for cluster
SPARK_DRIVER_MEMORY=8g
SPARK_EXECUTOR_MEMORY=24g
SPARK_EXECUTOR_CORES=8
SPARK_SHUFFLE_PARTITIONS=64

# ---- DDP Training ----
NPROC_PER_NODE=1               # GPUs per node (auto-detected if not set)
NNODES=1
MASTER_ADDR=localhost
MASTER_PORT=29500

# ---- HuggingFace ----
HF_ENDPOINT=https://hf-mirror.com

# ---- Model (override defaults) ----
# MODEL_NAME=roberta-base
# MAX_LENGTH=192
# BATCH_SIZE=32
# EPOCHS=1
# LEARNING_RATE=2e-5
# SUBSET_SIZE=500000           # Set to experiment with subset
